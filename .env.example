APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
SECURITY_LOG_LEVEL=warning
SECURITY_LOG_RETENTION_DAYS=30

SECURITY_REQUEST_TIMEOUT_SECONDS=30
SECURITY_MAX_BODY_SIZE_BYTES=10485760
SECURITY_MAX_CONCURRENT_REQUESTS=50
SECURITY_PUBLIC_RATE_LIMIT_PER_MINUTE=120
SECURITY_PUBLIC_RATE_LIMIT_PER_HOUR=1200
SECURITY_AUTH_RATE_LIMIT_PER_MINUTE=240
SECURITY_AUTH_RATE_LIMIT_PER_HOUR=2400
SECURITY_SENSITIVE_RATE_LIMIT_PER_MINUTE=20
SECURITY_SENSITIVE_RATE_LIMIT_PER_HOUR=100
SECURITY_HONEYPOT_RATE_LIMIT_PER_MINUTE=3
SECURITY_DASHBOARD_RATE_LIMIT_PER_MINUTE=30
SECURITY_PROGRESSIVE_THRESHOLD_PER_HOUR=600
SECURITY_PROGRESSIVE_STRICT_PER_MINUTE=30
SECURITY_TRAFFIC_WINDOW_MINUTES=5
SECURITY_ANOMALY_REQUESTS_PER_MINUTE_PER_IP=180
SECURITY_SLOW_REQUEST_MS=2000
SECURITY_HIGH_MEMORY_BYTES=67108864

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bdrs_react
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=s3
PUBLIC_UPLOADS_DISK=s3
PRIVATE_UPLOADS_DISK=s3-private
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_VISIBILITY=public
AWS_USE_PATH_STYLE_ENDPOINT=false

IDENTITY_VERIFICATION_DISK="${PRIVATE_UPLOADS_DISK}"
IDENTITY_VERIFICATION_STORAGE_ROOT=verifications
IDENTITY_VERIFICATION_QUEUE=identity-verification
IDENTITY_VERIFICATION_CLEANUP_QUEUE=maintenance
IDENTITY_VERIFICATION_MAX_UPLOAD_KB=10240
IDENTITY_VERIFICATION_SERVER_PRECHECK_ENABLED=false
IDENTITY_AI_BASE_URL=http://127.0.0.1:8067
IDENTITY_AI_TIMEOUT_SECONDS=30
IDENTITY_AI_PRECHECK_TIMEOUT_SECONDS=20
IDENTITY_AI_RETRY_TIMES=2
IDENTITY_AI_RETRY_SLEEP_MS=500
IDENTITY_AI_CIRCUIT_FAILURE_THRESHOLD=3
IDENTITY_AI_CIRCUIT_COOLDOWN_SECONDS=60
IDENTITY_VERIFICATION_ANTIVIRUS_ENABLED=false
IDENTITY_VERIFICATION_CLAMAV_HOST=127.0.0.1
IDENTITY_VERIFICATION_CLAMAV_PORT=3310
IDENTITY_VERIFICATION_WASM_MODE=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
